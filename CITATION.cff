    given-names: Rodrigo Silva
    orcid: https://orcid.org/0000-0002-6866-6971
    affiliation: >
      Departamento de Geografia e Planejamento Ambiental,
      IGCE — Unesp Rio Claro
    email: rodrigo.s.lemos@unesp.br
version: "1.1"
date-released: 2026-10-14
doi: 10.5281/zenodo.21364767
license: GPL-3.0
repository-code: https://github.com/rodrigoslemos-unesp/PlugIn-QGIS-AnP
keywords:
  - MapBiomas
  - QGIS
  - ecologia da paisagem
  - fragmentação
  - cobertura da terra
  - geoprocessamento
